# Copy to terraform.tfvars, which git ignores. Identifiers and flags only, never secret values.
# Secrets go into Secret Manager with `gcloud secrets versions add`. Production uses its own
# project, OAuth clients and credentials. Never copy staging values here.
project_id      = "your-gluons-prod-project"
region          = "us-central1"
deploy_services = false
# billing_account      = "000000-000000-000000"
# alert_email          = "oncall@your-domain.example"
# github_repository    = "your-org/gluons"
# api_host             = "api.your-domain.example"
# web_host             = "app.your-domain.example"
# enable_load_balancer = true
# plain_env = {
#   GLUONS_GOOGLE_CLIENT_ID = "..."
#   GLUONS_MAIL_FROM        = "Gluons <no-reply@your-domain.example>"
# }
# populated_secrets = ["smtp-url", "google-client-secret"]
