# Gluons configuration template. Placeholders only.
#
# Local: copy to .env, which git ignores, and fill in only what you are testing. An empty
#        value means the feature reports a configuration requirement instead of working.
#        scripts/dev.py sets the database and URL values itself.
# Hosted: do not use a .env file. Terraform sets plain values and Cloud Run injects secrets
#        from Secret Manager. Each [secret] line names its Secret Manager secret.
#
# Never paste a real value into chat, a ticket, a commit or a screenshot.
# docs/EXTERNAL_DEPENDENCIES.md explains each service once, in the order to set it up.
# Saving a key does not complete an integration or authorize any action: acting still needs
# a signed owner policy.
#
# Lines left commented show the default. Keep them commented unless you need to change it,
# because an empty numeric value fails at startup.

# ----------------------------------------------------------------------------- Core
# local | test | staging | production. Staging and production refuse to boot with
# development keys or non-https URLs.
GLUONS_ENV=local
GLUONS_PUBLIC_API_URL=http://localhost:8000
GLUONS_PUBLIC_WEB_URL=http://localhost:3000
# Proxies in front of the API that append to X-Forwarded-For. 0 trusts no header (local).
# Behind Google's external Application Load Balancer this is 2; confirm on first deploy.
GLUONS_TRUSTED_PROXY_HOPS=0
# Per-address limits on sign-in, registration, OAuth and the Shopify app URL.
GLUONS_RATE_LIMITS_ENABLED=true
# Days between a deletion request and the purge that erases the business's records.
GLUONS_DELETION_GRACE_DAYS=30
# Comma separated origins allowed to call the API from a browser.
GLUONS_ALLOWED_WEB_ORIGINS=http://localhost:3000
# Paths are worked out from the checkout. Override only for an unusual layout.
# GLUONS_SKILLS_DIR=
# GLUONS_BLUEPRINT_DIR=
# Reviewed HTTPS client metadata hosts for CIMD, comma separated. Empty disables discovery.
GLUONS_OAUTH_CIMD_HOSTS=

# ----------------------------------------------------------------------------- Database
# Three roles on purpose. The defaults point at Docker Compose on port 5433. The dev scripts
# use embedded PostgreSQL. Hosted: the private IP is the Terraform output database_private_ip,
# and the migration creates gluons_app and gluons_system. Never make them with the Cloud SQL
# console, which would add them to cloudsqlsuperuser.
# [secret: gluons-database-url]
# GLUONS_DATABASE_URL=postgresql+psycopg://gluons_app:PASSWORD@HOST:5432/gluons?sslmode=require
# [secret: gluons-system-database-url]
# GLUONS_SYSTEM_DATABASE_URL=postgresql+psycopg://gluons_system:PASSWORD@HOST:5432/gluons?sslmode=require
# [secret: gluons-migration-database-url] Read by the migrate job only.
# GLUONS_MIGRATION_DATABASE_URL=postgresql+psycopg://gluons_migrator:PASSWORD@HOST:5432/gluons?sslmode=require
# [secrets: gluons-app-role-password, gluons-system-role-password] Migrate job only. Generate
# each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# They must match the passwords inside the URLs above.
# GLUONS_APP_ROLE_PASSWORD=
# GLUONS_SYSTEM_ROLE_PASSWORD=
# Local only: gives the roles throwaway passwords. Never set this in a hosted environment.
# GLUONS_DEV_ROLE_PASSWORDS=1

# ----------------------------------------------------------------------------- Keys
# Both defaults are published development keys, rejected in staging and production.
# [secret: gluons-signing-key] Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# GLUONS_SIGNING_KEY_B64=
# Hosted vaults use Cloud KMS. Terraform output kms_key gives this value.
# GLUONS_KMS_KEY_NAME=projects/PROJECT/locations/REGION/keyRings/gluons-ENV-vault/cryptoKeys/provider-credentials
# Local or self-managed key-encryption key, used only when GLUONS_KMS_KEY_NAME is unset.
# GLUONS_VAULT_KEK_B64=

# ----------------------------------------------------------------------------- Sessions and links
# GLUONS_SESSION_TTL_HOURS=72
# GLUONS_SESSION_COOKIE_NAME=gluons_session
# GLUONS_MFA_REQUIRED_FOR_OWNERS=false
# GLUONS_CONNECTION_SESSION_TTL_SECONDS=600
# GLUONS_SETUP_LINK_TTL_SECONDS=900
# GLUONS_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# GLUONS_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# GLUONS_APPROVAL_DEFAULT_TTL_SECONDS=86400

# ----------------------------------------------------------------------------- Account email
# file writes messages to GLUONS_MAIL_DIR. smtp is required in hosted environments.
GLUONS_MAIL_TRANSPORT=file
GLUONS_MAIL_DIR=.gluons-data/mail
# [secret: gluons-smtp-url] From your mail provider. The sender uses STARTTLS, so this must be
# a port 587 style endpoint. Implicit TLS on port 465 does not work.
# GLUONS_SMTP_URL=smtp://USERNAME:PASSWORD@smtp.your-provider.example:587
# GLUONS_MAIL_FROM=Gluons <no-reply@your-domain.example>

# ----------------------------------------------------------------------------- Worker and queues
# GLUONS_WORKER_LEASE_SECONDS=120
# GLUONS_WORKER_POLL_SECONDS=1.0
# postgres is the only implemented backend. cloud_tasks is accepted but nothing enqueues
# through it yet, so hosted workers are woken by the Cloud Scheduler job.
# GLUONS_QUEUE_BACKEND=postgres
# GLUONS_CLOUD_TASKS_QUEUE=
# Worker wake endpoint. Set on the private worker only, by Terraform. Leave all three unset
# on every public service, where they make the route reject everything.
# GLUONS_WORKER_WAKE_URL=
# Expected OIDC audience. Defaults to GLUONS_WORKER_WAKE_URL when unset.
# GLUONS_WORKER_WAKE_AUDIENCE=
# Service account allowed to wake the worker: gluons-scheduler@PROJECT.iam.gserviceaccount.com
# GLUONS_WORKER_SERVICE_ACCOUNT=

# ----------------------------------------------------------------------------- Google Cloud
# Project id from the Google Cloud console.
# GLUONS_GCP_PROJECT_ID=
GLUONS_GCP_REGION=us-central1
# Terraform output or topic id: projects/PROJECT/topics/gluons-ENV-state-events
# GLUONS_PUBSUB_EVENTS_TOPIC=
# Evidence bucket name from Terraform.
# GLUONS_ARTIFACTS_BUCKET=

# ----------------------------------------------------------------------------- Logging and tracing
# DEBUG, INFO, WARNING or ERROR.
# GLUONS_LOG_LEVEL=INFO
# json or text. Defaults to json when hosted and text locally.
# GLUONS_LOG_FORMAT=text
# Set to 1 to export spans. Needs the OpenTelemetry packages, which are not in the image.
# GLUONS_OTEL_ENABLED=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ----------------------------------------------------------------------------- Google OAuth and Gmail
# Cloud console > Google Auth Platform > Clients > Create client > Web application. Create it
# in the project that owns the Pub/Sub topic: Gmail requires them to match. Callback:
# http://localhost:8000/v1/oauth/gmail/callback, or the https API origin when hosted.
GLUONS_GOOGLE_CLIENT_ID=
# [secret: gluons-google-client-secret]
GLUONS_GOOGLE_CLIENT_SECRET=
# Hosted values come from Terraform. Local Gmail push needs a real topic and a public endpoint.
GLUONS_GMAIL_PUBSUB_TOPIC=
GLUONS_GMAIL_PUSH_AUDIENCE=
GLUONS_GMAIL_PUSH_SERVICE_ACCOUNT=

# ----------------------------------------------------------------------------- Meta WhatsApp
# Meta for Developers > your app > App settings > Basic. Needs Tech Provider status.
# The App Store listing or install link owners use to start from Shopify (https only).
GLUONS_SHOPIFY_INSTALL_URL=
# Comma separated shop domains an operator approved for manual Shopify pilots.
GLUONS_SHOPIFY_PILOT_SHOPS=
# Carrier tracking read used to verify physical transit before a fulfillment record.
GLUONS_SHIPPO_API_TOKEN=

GLUONS_META_APP_ID=
# [secret: gluons-meta-app-secret]
GLUONS_META_APP_SECRET=
# WhatsApp > Embedded Signup builder configuration id.
GLUONS_META_CONFIG_ID=
# [secret: gluons-meta-webhook-verify-token] Any random string you also enter in Meta.
GLUONS_META_WEBHOOK_VERIFY_TOKEN=
# Research records v26.0 as current.
# GLUONS_META_GRAPH_VERSION=v26.0

# ----------------------------------------------------------------------------- ElevenLabs
# elevenlabs.io > Developers > API keys. Use a separate workspace for each environment.
# [secret: gluons-elevenlabs-api-key]
GLUONS_ELEVENLABS_API_KEY=
# [secret: gluons-elevenlabs-webhook-secret] Shown when you create the post-call webhook.
GLUONS_ELEVENLABS_WEBHOOK_SECRET=
# [secret: gluons-elevenlabs-tool-secret] Generate your own random value. ElevenLabs tool
# calls authenticate with a static header, so this is what protects them.
GLUONS_ELEVENLABS_TOOL_SECRET=

# ----------------------------------------------------------------------------- Twilio
# console.twilio.com > Account info. US and UK numbers only: Twilio sells no India local or
# mobile numbers, so India routes through Exotel or SIP. See docs/EXTERNAL_DEPENDENCIES.md.
GLUONS_TWILIO_ACCOUNT_SID=
# [secret: gluons-twilio-auth-token]
GLUONS_TWILIO_AUTH_TOKEN=

# ----------------------------------------------------------------------------- Shopify
# Shopify Dev Dashboard > your app > Settings. Until app review, one pilot merchant or dev stores.
GLUONS_SHOPIFY_CLIENT_ID=
# [secret: gluons-shopify-client-secret]
GLUONS_SHOPIFY_CLIENT_SECRET=
# GLUONS_SHOPIFY_API_VERSION=2026-10

# ----------------------------------------------------------------------------- Stripe
# dashboard.stripe.com > Developers > API keys. Use test mode until billing is decided.
# [secret: gluons-stripe-secret-key]
GLUONS_STRIPE_SECRET_KEY=
# [secret: gluons-stripe-webhook-secret] Shown when you add the webhook endpoint.
GLUONS_STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------- Models
# Background inference is billed separately from assistant subscriptions. Each model also
# needs a reviewed descriptor and passing skill evaluations in the database.
# [secret: gluons-anthropic-api-key] console.anthropic.com > API keys.
GLUONS_ANTHROPIC_API_KEY=
# [secret: gluons-openai-api-key] platform.openai.com > API keys.
GLUONS_OPENAI_API_KEY=
# Gemini on Vertex AI uses Application Default Credentials. Never download a key file.
GLUONS_GOOGLE_GENAI_PROJECT=
# Your own OpenAI-compatible endpoint, if any.
GLUONS_PRIVATE_LLM_BASE_URL=
# [secret: gluons-private-llm-api-key]
GLUONS_PRIVATE_LLM_API_KEY=

# ----------------------------------------------------------------------------- ERP
# Base URL of a real ERPNext site. Unset means only the labelled simulator is available.
# GLUONS_ERPNEXT_BASE_URL=https://erp.your-domain.example
# GLUONS_SANDBOX_ERP_URL=http://127.0.0.1:8100
# Simulator process only. These throwaway defaults exist for local tests.
# SANDBOX_ERP_DB=.gluons-data/sandbox_erp.sqlite3
# SANDBOX_ERP_API_KEY=sandbox-key
# SANDBOX_ERP_API_SECRET=sandbox-secret

# ----------------------------------------------------------------------------- Optional automation backend
# Activepieces flow webhook URL, if you run that sidecar. See ADR-018.
# GLUONS_ACTIVEPIECES_FLOW_URL=

# ----------------------------------------------------------------------------- Web app
# Compiled into the browser bundle at build time, so it is public and never a secret.
# NEXT_PUBLIC_API_URL=http://localhost:8000
