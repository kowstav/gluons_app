# Copy to .env locally. Never paste real values into chat or commit the .env file.
# scripts/dev.py provisions an embedded local database; Docker Compose has its own
# local-only database URLs. Hosted URLs and keys must be injected from Secret Manager.
GLUONS_ENV=local
GLUONS_PUBLIC_API_URL=http://localhost:8000
GLUONS_PUBLIC_WEB_URL=http://localhost:3000
GLUONS_ALLOWED_WEB_ORIGINS=http://localhost:3000
GLUONS_MAIL_TRANSPORT=file
GLUONS_MAIL_DIR=.gluons-data/mail
# Hosted: smtp plus approved mail delivery, HTTPS, independent random signing key,
# Cloud KMS and least-privilege app/system/migration database roles are mandatory.
# GLUONS_SMTP_URL=smtps://username:password@approved-smtp-host:465
# GLUONS_MAIL_FROM=Gluons <no-reply@your-domain.example>
# GLUONS_SIGNING_KEY_B64=replace-with-random-32-byte-base64-key
# GLUONS_KMS_KEY_NAME=projects/PROJECT/locations/REGION/keyRings/gluons/cryptoKeys/vault
# GLUONS_DATABASE_URL=postgresql+psycopg://gluons_app:PASSWORD@HOST/gluons
# GLUONS_SYSTEM_DATABASE_URL=postgresql+psycopg://gluons_system:PASSWORD@HOST/gluons
# GLUONS_MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATOR:PASSWORD@HOST/gluons

# Google: create a Web OAuth client, add authorized test users and enable Gmail API.
# Exact callback: http://localhost:8000/v1/oauth/gmail/callback (HTTPS when hosted).
GLUONS_GOOGLE_CLIENT_ID=
GLUONS_GOOGLE_CLIENT_SECRET=
GLUONS_GMAIL_PUBSUB_TOPIC=
GLUONS_GMAIL_PUSH_AUDIENCE=
GLUONS_GMAIL_PUSH_SERVICE_ACCOUNT=

# Optional reviewed HTTPS client metadata origins; empty disables CIMD discovery.
GLUONS_OAUTH_CIMD_HOSTS=

# Provider-specific implementation/approval status is in docs/EXTERNAL_DEPENDENCIES.md.
# Saving these values does not by itself complete an integration or authorize actions.
GLUONS_META_APP_ID=
GLUONS_META_APP_SECRET=
GLUONS_META_CONFIG_ID=
GLUONS_META_WEBHOOK_VERIFY_TOKEN=
GLUONS_ELEVENLABS_API_KEY=
GLUONS_ELEVENLABS_WEBHOOK_SECRET=
GLUONS_ELEVENLABS_TOOL_SECRET=
GLUONS_TWILIO_ACCOUNT_SID=
GLUONS_TWILIO_AUTH_TOKEN=
GLUONS_SHOPIFY_CLIENT_ID=
GLUONS_SHOPIFY_CLIENT_SECRET=
GLUONS_STRIPE_SECRET_KEY=
GLUONS_STRIPE_WEBHOOK_SECRET=

# Background inference is billed separately from assistant subscriptions.
# Models also need reviewed descriptors and passing skill evaluations in the DB.
GLUONS_OPENAI_API_KEY=
GLUONS_ANTHROPIC_API_KEY=
# Gemini uses ADC; do not download a service-account private key.
GLUONS_GOOGLE_GENAI_PROJECT=
GLUONS_GCP_REGION=us-central1
GLUONS_PRIVATE_LLM_BASE_URL=
GLUONS_PRIVATE_LLM_API_KEY=
